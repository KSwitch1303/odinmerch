# Copy to .env.local and fill in real values. Never commit .env.local.
# Source: https://github.com/KSwitch1303/odinmerch

# --- MongoDB (required) ---
# Connection string; the app uses the "luxury-ecommerce" database.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/luxury-ecommerce?retryWrites=true&w=majority

# --- Supabase (required) ---
# Project Settings -> API. Exposed to the browser, so use the anon/public key only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# Server-only key used by /api/upload to bypass Storage RLS. Optional, but without it
# uploads need a Storage insert policy on the bucket. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for product and brand images (defaults to "products").
SUPABASE_UPLOAD_BUCKET=products

# --- Admin access ---
# Comma-separated emails treated as admins. Image uploads only honour this list,
# not the role stored in MongoDB.
ADMIN_EMAILS=admin@example.com

# --- Paystack (required for checkout) ---
# Dashboard -> Settings -> API Keys & Webhooks. Use sk_test_/pk_test_ keys locally;
# live keys charge real cards. The secret key is server-only.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL Paystack redirects back to after payment. Defaults to the
# request's origin; set it in production (e.g. https://odinmerch.com).
APP_URL=
# Webhook URL to register in the Paystack dashboard: <APP_URL>/api/payments/webhook
